#include <stdio.h>
#include <stddef.h>
int main(){
    char plaintext[]="Hello";
    size_t elem=sizeof(plaintext)/sizeof(plaintext[0]);
    char plaintext2[elem];
    for(size_t i=0;i<elem;i++){
        char ch[elem];
        ch[i]=plaintext[i];
        int a=(int)ch[i];
        a=a+3;
        if(a==88){
           plaintext2[i]='A';
        }
        else if(a==89){
            plaintext2[i]='B';
        }
        else if(a==90){
            plaintext2[i]='C';
        }
        else if(a==120){
            plaintext2[i]='a';
        }
        else if(a==122){
            plaintext2[i]='b';
        }
        else if(a==123){
            plaintext2[i]='c';
        }
        plaintext2[i]=(char)a;
    }
    printf("%s\n",plaintext2);
    return 0;  
}
